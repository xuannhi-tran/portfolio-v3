# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# console.anthropic.com → API keys. Prepaid credit, auto-reload off.
ANTHROPIC_API_KEY=
# Optional. Default claude-haiku-5-5 (cheap and fast). claude-opus-5-5 for the strongest answers.
ANTHROPIC_MODEL=claude-haiku-5-5

# dashboard.voyageai.com → API keys (embeddings)
VOYAGE_API_KEY=

# Supabase → Project Settings → API. Use the *secret* key (server only), not the publishable one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Spend guards (optional)
ASK_PER_IP_HOUR=10
ASK_PER_DAY=300
